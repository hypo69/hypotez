3f\u1080\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1073\'3f\u1086\'3f\u1083\'3f\u1077\'3f\u1077\'3f \u1095\'3f\u1077\'3f\u1084\'3f \u1085\'3f\u1072\'3f 17 \u1090\'3f\u1086\'3f\u1095\'3f\u1077\'3f\u1082\'3f \u1076\'3f\u1086\'3f \u1082\'3f\u1088\'3f\u1072\'3f\u1103\'3f: \u1088\'3f\u1072\'3f\u1089\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1103\'3f\u1085\'3f\u1080\'3f\u1077\'3f \u1084\'3f\u1077\'3f\u1078\'3f\u1076\'3f\u1091\'3f \u1084\'3f\u1072\'3f\u1096\'3f\u1080\'3f\u1085\'3f\u1072\'3f\u1084\'3f\u1080\'3f \u1087\'3f\u1086\'3f\u1076\'3f\u1076\'3f\u1077\'3f\u1088\'3f\u1078\'3f\u1080\'3f\u1074\'3f\u1072\'3f\u1077\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1087\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1103\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1084\'3f. \u1071\'3f \u1088\'3f\u1077\'3f\u1096\'3f\u1080\'3f\u1083\'3f \u1089\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1089\'3f\u1082\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1100\'3f \u1084\'3f\u1072\'3f\u1096\'3f\u1080\'3f\u1085\'3f \u1088\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1091\'3f\u1097\'3f\u1077\'3f\u1081\'3f \u1085\'3f\u1072\'3f 1 \u1090\'3f\u1086\'3f\u1095\'3f\u1082\'3f\u1091\'3f \u1087\'3f\u1088\'3f\u1080\'3f \u1082\'3f\u1072\'3f\u1078\'3f\u1076\'3f\u1086\'3f\u1081\'3f \u1089\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1077\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1089\'3f\u1099\'3f: \u1086\'3f\u1085\'3f\u1072\'3f \u1088\'3f\u1072\'3f\u1074\'3f\u1085\'3f\u1072\'3f 6 \u1074\'3f\u1086\'3f \u1074\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1081\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1089\'3f\u1077\'3f, 7 \u8211\'96 \u1074\'3f \u1090\'3f\u1088\'3f\u1077\'3f\u1090\'3f\u1100\'3f\u1077\'3f\u1081\'3f\u8230\'85}
