\u1044\'3f\u1077\'3f\u1083\'3f\u1086\'3f \u1079\'3f\u1076\'3f\u1077\'3f\u1089\'3f\u1100\'3f \u1074\'3f \u1086\'3f\u1076\'3f\u1085\'3f\u1086\'3f\u1084\'3f \u1080\'3f\u1079\'3f \u1086\'3f\u1089\'3f\u1085\'3f\u1086\'3f\u1074\'3f\u1085\'3f\u1099\'3f\u1093\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1085\'3f\u1094\'3f\u1080\'3f\u1087\'3f\u1086\'3f\u1074\'3f \u1096\'3f\u1072\'3f\u1076\'3f\u1086\'3f\u1082\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1081\'3f \u1083\'3f\u1086\'3f\u1075\'3f\u1080\'3f\u1082\'3f\u1080\'3f: \u171\'ab\u1053\'3f\u1077\'3f\u1090\'3f \u1085\'3f\u1080\'3f\u1095\'3f\u1077\'3f\u1075\'3f\u1086\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1073\'3f\u1099\'3f \u1085\'3f\u1077\'3f\u1087\'3f\u1088\'3f\u1077\'3f\u1088\'3f\u1099\'3f\u1074\'3f\u1085\'3f\u1086\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1086\'3f\u1083\'3f\u1078\'3f\u1072\'3f\u1083\'3f\u1086\'3f\u1089\'3f\u1100\'3f \u1080\'3f \u1085\'3f\u1077\'3f \u1082\'3f\u1086\'3f\u1085\'3f\u1095\'3f\u1080\'3f\u1083\'3f\u1086\'3f\u1089\'3f\u1100\'3f \u1091\'3f\u1089\'3f\u1087\'3f\u1077\'3f\u1093\'3f\u1086\'3f\u1084\'3f\u187\'bb. \u1048\'3f\u1083\'3f\u1080\'3f, \u1074\'3f \u1076\'3f\u1088\'3f\u1091\'3f\u1075\'3f\u1080\'3f\u1093\'3f \u1074\'3f\u1099\'3f\u1088\'3f\u1072\'3f\u1078\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1103\'3f\u1093\'3f: \u171\'ab\u1063\'3f\u1077\'3f\u1084\'3f \u1073\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1096\'3f\u1077\'3f \u1085\'3f\u1077\'3f\u1091\'3f\u1076\'3f\u1072\'3f\u1095\'3f, \u1090\'3f\u1077\'3f\u1084\'3f \u1073\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1096\'3f\u1077\'3f \u1096\'3f\u1072\'3f\u1085\'3f\u1089\'3f\u1086\'3f\u1074\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1086\'3f\u1085\'3f\u1086\'3f \u1079\'3f\u1072\'3f\u1088\'3f\u1072\'3f\u1073\'3f\u1086\'3f\u1090\'3f\u1072\'3f\u1077\'3f\u1090\'3f\u187\'bb. \u1048\'3f\u1093\'3f \u1088\'3f\u1072\'3f\u1082\'3f\u1077\'3f\u1090\'3f\u1072\'3f \u1077\'3f\u1097\'3f\u1077\'3f \u1085\'3f\u1077\'3f\u1089\'3f\u1086\'3f\u1074\'3f\u1077\'3f\u1088\'3f\u1096\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1072\'3f, \u1085\'3f\u1086\'3f \u1086\'3f\u1085\'3f\u1080\'3f \u1074\'3f\u1099\'3f\u1095\'3f\u1080\'3f\u1089\'3f\u1083\'3f\u1080\'3f\u1083\'3f\u1080\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1091\'3f \u1085\'3f\u1080\'3f\u1093\'3f \u1077\'3f\u1089\'3f\u1090\'3f\u1100\'3f \u1087\'3f\u1086\'3f \u1082\'3f\u1088\'3f\u1072\'3f\u1081\'3f\u1085\'3f\u1077\'3f\u1081\'3f \u1084\'3f\u1077\'3f\u1088\'3f\u1077\'3f \u1086\'3f\u1076\'3f\u1080\'3f\u1085\'3f \u1096\'3f\u1072\'3f\u1085\'3f\u1089\'3f \u1080\'3f\u1079\'3f \u1084\'3f\u1080\'3f\u1083\'3f\u1083\'3f\u1080\'3f\u1086\'3f\u1085\'3f\u1072\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1086\'3f\u1085\'3f\u1072\'3f \u1079\'3f\u1072\'3f\u1088\'3f\u1072\'3f\u1073\'3f\u1086\'3f\u1090\'3f\u1072\'3f\u1077\'3f\u1090\'3f\u8230\'85 \u1048\'3f \u1086\'3f\u1085\'3f\u1080\'3f \u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1087\'3f\u1103\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1087\'3f\u1086\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1088\'3f\u1077\'3f\u1077\'3f \u1086\'3f\u1089\'3f\u1091\'3f\u1097\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1080\'3f\u1090\'3f\u1100\'3f 999999 \u1087\'3f\u1077\'3f\u1088\'3f\u1074\'3f\u1099\'3f\u1093\'3f \u1085\'3f\u1077\'3f\u1091\'3f\u1076\'3f\u1072\'3f\u1095\'3f\u1085\'3f\u1099\'3f\u1093\'3f \u1086\'3f\u1087\'3f\u1099\'3f\u1090\'3f\u1086\'3f\u1074\'3f, \u1095\'3f\u1090\'3f\u1086\'3f\u1073\'3f\u1099\'3f \u1073\'3f\u1099\'3f\u1090\'3f\u1100\'3f \u1091\'3f\u1074\'3f\u1077\'3f\u1088\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1084\'3f\u1080\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1084\'3f\u1080\'3f\u1083\'3f\u1083\'3f\u1080\'3f\u1086\'3f\u1085\'3f\u1085\'3f\u1072\'3f\u1103\'3f \u1079\'3f\u1072\'3f\u1088\'3f\u1072\'3f\u1073\'3f\u1086\'3f\u1090\'3f\u1072\'3f\u1077\'3f\u1090\'3f\u187\'bb. (\u1046\'3f\u1072\'3f\u1082\'3f \u1056\'3f\u1091\'3f\u1082\'3f\u1089\'3f\u1077\'3f\u1083\'3f\u1100\'3f. \u1042\'3f\u1077\'3f\u1083\'3f\u1080\'3f\u1082\'3f\u1086\'3f\u1083\'3f\u1077\'3f\u1087\'3f\u1080\'3f\u1077\'3f \u1085\'3f\u1072\'3f\u1074\'3f\u1099\'3f\u1074\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1090\'3f. \u1055\'3f\u1072\'3f\u1088\'3f\u1080\'3f\u1078\'3f, \u1080\'3f\u1079\'3f\u1076\'3f\u1072\'3f\u1090\'3f\u1077\'3f\u1083\'3f\u1100\'3f\u1089\'3f\u1090\'3f\u1074\'3f\u1086\'3f \u1043\'3f\u1088\'3f\u1072\'3f\u1089\'3f\u1089\'3f\u1077\'3f.)}
\par \pard\plain \s0\rtlch\af11\afs24\alang1037 \ltrch\lang1049\langfe2052\hich\af5\loch\qj\fi567\nowidctlpar\hyphpar0\rtlpar\f5\fs24\i0\b0\cf0\lang1049\kerning1\dbch\af8\langfe2052\ql\fi567\li0\lin0\ri0\rin0\sb0\sa0\ltrpar{\loch\lang1049\loch
\u1042\'3f\u1077\'3f\u1083\'3f\u1080\'3f\u1082\'3f\u1080\'3f\u1081\'3f \u1082\'3f\u1086\'3f\u1083\'3f\u1076\'3f\u1091\'3f\u1085\'3f \u1089\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1072\'3f\u1083\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1088\'3f\u1072\'3f\u1082\'3f\u1077\'3f\u1090\'3f\u1099\'3f \u1090\'3f\u1077\'3f\u1088\'3f\u1087\'3f\u1103\'3f\u1090\'3f \u1085\'3f\u1077\'3f\u1091\'3f\u1076\'3f\u1072\'3f\u1095\'3f\u1091\'3f \u1087\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1084\'3f\u1091\'3f, \u1095\'3f\u1090\'3f\u1086\'3f \u1085\'3f\u1077\'3f \u1093\'3f\u1074\'3f\u1072\'3f\u1090\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1074\'3f \u1074\'3f \u1089\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1077\'3f\u1084\'3f\u1072\'3f\u1093\'3f \u1073\'3f\u1077\'3f\u1079\'3f\u1086\'3f\u1087\'3f\u1072\'3f\u1089\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1080\'3f. \u1053\'3f\u1086\'3f \u1091\'3f \u1075\'3f\u1080\'3f\u1073\'3f\u1080\'3f \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f \u1089\'3f\u1086\'3f\u1073\'3f\u1080\'3f\u1088\'3f\u1072\'3f\u1102\'3f\u1090\'3f \u1089\'3f \u1088\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1081\'3f, \u1087\'3f\u1088\'3f\u1086\'3f\u1080\'3f\u1079\'3f\u1088\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1072\'3f\u1102\'3f\u1097\'3f\u1080\'3f\u1093\'3f \u1085\'3f\u1072\'3f \u1086\'3f\u1075\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1072\'3f\u1093\'3f. \u1056\'3f\u1077\'3f\u1096\'3f\u1077\'3f\u1085\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1089\'3f\u1083\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1086\'3f\u1076\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1080\'3f\u1079\'3f \u1096\'3f\u1072\'3f\u1076\'3f\u1086\'3f\u1082\'3f\u1086\'3f\u1074\'3f \u1085\'3f\u1072\'3f \u1087\'3f\u1083\'3f\u1072\'3f\u1085\'3f\u1077\'3f\u1090\'3f\u1091\'3f \u1075\'3f\u1080\'3f\u1073\'3f\u1080\'3f \u1080\'3f\u1089\'3f\u1082\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f. \u1043\'3f\u1080\'3f\u1073\'3f\u1080\'3f, \u1086\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1100\'3f \u1091\'3f\u1084\'3f\u1085\'3f\u1099\'3f\u1077\'3f \u1073\'3f\u1083\'3f\u1072\'3f\u1075\'3f\u1086\'3f\u1076\'3f\u1072\'3f\u1088\'3f\u1103\'3f \u1089\'3f\u1074\'3f\u1086\'3f\u1080\'3f\u1084\'3f \u1096\'3f\u1083\'3f\u1103\'3f\u1087\'3f\u1072\'3f\u1084\'3f, \u1073\'3f\u1099\'3f\u1089\'3f\u1090\'3f\u1088\'3f\u1086\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1085\'3f\u1080\'3f\u1082\'3f\u1083\'3f\u1080\'3f \u1074\'3f \u1087\'3f\u1083\'3f\u1072\'3f\u1085\'3f\u1099\'3f \u1096\'3f\u1072\'3f\u1076\'3f\u1086\'3f\u1082\'3f\u1086\'3f\u1074\'3f \u1080\'3f \u1088\'3f\u1077\'3f\u1096\'3f\u1080\'3f\u1083\'3f\u1080\'3f \u1087\'3f\u1086\'3f\u1079\'3f\u1072\'3f\u1073\'3f\u1072\'3f\u1074\'3f\u1080\'3f\u1090\'3f\u1100\'3f\u1089\'3f\u1103\'3f. \u1054\'3f\u1085\'3f\u1080\'3f \u1087\'3f\u1086\'3f\u1079\'3f\u1074\'3f\u1086\'3f\u1083\'3f\u1080\'3f\u1083\'3f\u1080\'3f \u1096\'3f\u1072\'3f\u1076\'3f\u1086\'3f\u1082\'3f\u1091\'3f \u1079\'3f\u1072\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1090\'3f\u1100\'3f\u1089\'3f\u1103\'3f \u1074\'3f \u1086\'3f\u1076\'3f\u1080\'3f\u1085\'3f \u1080\'3f\u1079\'3f \u1080\'3f\u1093\'3f \u1086\'3f\u1075\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1086\'3f\u1074\'3f, \u1085\'3f\u1086\'3f \u1086\'3f\u1082\'3f\u1088\'3f\u1091\'3f\u1078\'3f\u1080\'3f\u1083\'3f\u1080\'3f \u1077\'3f\u1075\'3f\u1086\'3f \u1089\'3f\u1086\'3f \u1074\'3f\u1089\'3f\u1077\'3f\u1093\'3f \u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1085\'3f, \u1080\'3f \u1074\'3f\u1089\'3f\u1103\'3f\u1082\'3f\u1080\'3f\u1081\'3f \u1088\'3f\u1072\'3f\u1079\'3f, \u1082\'3f\u1086\'3f\u1075\'3f\u1076\'3f\u1072\'3f \u1088\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f \u1088\'3f\u1072\'3f\u1089\'3f\u1094\'3f\u1074\'3f\u1077\'3f\u1090\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1080\'3f \u1076\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f, \u1086\'3f\u1085\'3f\u1080\'3f \u1084\'3f\u1095\'3f\u1072\'3f\u1090\'3f\u1089\'3f\u1103\'3f, \u1095\'3f\u1090\'3f\u1086\'3f\u1073\'3f\u1099\'3f \u1089\'3f\u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1091\'3f\u1088\'3f\u1086\'3f\u1078\'3f\u1072\'3f\u1081\'3f \u1087\'3f\u1088\'3f\u1077\'3f\u1078\'3f\u1076\'3f\u1077\'3f \u1096\'3f\u1072\'3f\u1076\'3f\u1086\'3f\u1082\'3f\u1072\'3f.}
\par \pard\plain \s0\rtlch\af11\afs24\alang1037 \ltrch\lang1049\langfe2052\hich\af5\loch\qj\fi567\nowidctlpar\hyphpar0\rtlpar\f5\fs24\i0\b0\cf0\lang1049\kerning1\dbch\af8\langfe2052\ql\fi567\li0\lin0\ri0\rin0\sb0\sa0\ltrpar{\loch\lang1049\loch
\u1042\'3f\u1086\'3f\u1090\'3f \u1074\'3f\u1072\'3f\u1084\'3f \u1090\'3f\u1077\'3f\u1084\'3f\u1072\'3f \u1080\'3f\u1075\'3f\u1088\'3f\u1099\'3f. \u1050\'3f\u1072\'3f\u1082\'3f \u1080\'3f \u1074\'3f \u1087\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1099\'3f\u1076\'3f\u1091\'3f\u1097\'3f\u1080\'3f\u1093\'3f \u1080\'3f\u1075\'3f\u1088\'3f\u1072\'3f\u1093\'3f, \u1103\'3f \u1087\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1083\'3f\u1072\'3f\u1075\'3f\u1072\'3f\u1102\'3f \u1079\'3f\u1076\'3f\u1077\'3f\u1089\'3f\u1100\'3f \u1074\'3f\u1077\'3f\u1088\'3f\u1089\'3f\u1080\'3f\u1102\'3f, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1091\'3f\u1102\'3f \u1103\'3f \u1088\'3f\u1077\'3f\u1072\'3f\u1083\'3f\u1080\'3f\u1079\'3f\u1086\'3f\u1074\'3f\u1072\'3f\u1083\'3f \u1085\'3f\u1072\'3f \u1089\'3f\u1074\'3f\u1086\'3f\u1077\'3f\u1084\'3f \u1084\'3f\u1080\'3f\u1082\'3f\u1088\'3f\u1086\'3f\u1082\'3f\u1086\'3f\u1084\'3f\u1087\'3f\u1100\'3f\u1102\'3f\u1090\'3f\u1077\'3f\u1088\'3f\u1077\'3f, \u1042\'3f\u1099\'3f \u1084\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1090\'3f\u1077\'3f \u1087\'3f\u1086\'3f\u1076\'3f\u1086\'3f\u1075\'3f\u1085\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1087\'3f\u1072\'3f\u1088\'3f\u1072\'3f\u1084\'3f\u1077\'3f\u1090\'3f\u1088\'3f\u1099\'3f \u1074\'3f \u1079\'3f\u1072\'3f\u1074\'3f\u1080\'3f\u1089\'3f\u1080\'3f\u1084\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1080\'3f \u1086\'3f\u1090\'3f \u1074\'3f\u1086\'3f\u1079\'3f\u1084\'3f\u1086\'3f\u1078\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1077\'3f\u1081\'3f \u1074\'3f\u1072\'3f\u1096\'3f\u1077\'3f\u1081\'3f \u1084\'3f\u1072\'3f\u1096\'3f\u1080\'3f\u1085\'3f\u1072\'3f, \u1072\'3f \u1090\'3f\u1072\'3f\u1082\'3f\u1078\'3f\u1077\'3f \u1074\'3f \u1079\'3f\u1072\'3f\u1074\'3f\u1080\'3f\u1089\'3f\u1080\'3f\u1084\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1080\'3f \u1086\'3f\u1090\'3f \u1078\'3f\u1077\'3f\u1083\'3f\u1072\'3f\u1077\'3f\u1084\'3f\u1086\'3f\u1081\'3f \u1090\'3f\u1088\'3f\u1091\'3f\u1076\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1080\'3f \u1080\'3f\u1075\'3f\u1088\'3f\u1099\'3f \u1080\'3f \u1096\'3f\u1072\'3f\u1085\'3f\u1089\'3f\u1086\'3f\u1074\'3f \u1085\'3f\u1072\'3f \u1091\'3f\u1089\'3f\u1087\'3f\u1077\'3f\u1093\'3f. \u1041\'3f\u1099\'3f\u1083\'3f\u1086\'3f \u1073\'3f\u1099\'3f \u1073\'3f\u1083\'3f\u1072\'3f\u1075\'3f\u1086\'3f\u1088\'3f\u1072\'3f\u1079\'3f\u1091\'3f\u1084\'3f\u1085\'3f\u1086\'3f. \u1042\'3f \u1087\'3f\u1077\'3f\u1088\'3f\u1074\'3f\u1099\'3f\u1093\'3f \u1074\'3f\u1077\'3f\u1088\'3f\u1089\'3f\u1080\'3f\u1103\'3f\u1093\'3f \u1080\'3f\u1079\'3f \u1086\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1078\'3f\u1085\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1080\'3f \u1089\'3f\u1090\'3f\u1086\'3f\u1080\'3f\u1090\'3f \u1089\'3f\u1095\'3f\u1080\'3f\u1090\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1074\'3f\u1089\'3f\u1077\'3f \u1087\'3f\u1072\'3f\u1088\'3f\u1072\'3f\u1084\'3f\u1077\'3f\u1090\'3f\u1088\'3f\u1099\'3f \u1076\'3f\u1086\'3f \u1085\'3f\u1072\'3f\u1095\'3f\u1072\'3f\u1083\'3f\u1072\'3f \u1082\'3f\u1072\'3f\u1078\'3f\u1076\'3f\u1086\'3f\u1081\'3f \u1087\'3f\u1072\'3f\u1088\'3f\u1090\'3f\u1080\'3f\u1080\'3f. \u1042\'3f\u1099\'3f \u1089\'3f\u1084\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1090\'3f\u1077\'3f \u1090\'3f\u1072\'3f\u1082\'3f\u1078\'3f\u1077\'3f \u1089\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1085\'3f\u1077\'3f\u1089\'3f\u1082\'3f\u1086\'3f\u1083\'3f\u1100\'3f\u1082\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1087\'3f\u1099\'3f\u1090\'3f\u1086\'3f\u1082\'3f, \u1095\'3f\u1090\'3f\u1086\'3f\u1073\'3f\u1099\'3f \u1076\'3f\u1086\'3f\u1073\'3f\u1080\'3f\u1090\'3f\u1100\'3f\u1089\'3f\u1103\'3f \u1091\'3f\u1076\'3f\u1086\'3f\u1074\'3f\u1083\'3f\u1077\'3f\u1090\'3f\u1074\'3f\u1086\'3f\u1088\'3f\u1080\'3f\u1090\'3f\u1077\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1088\'3f\u1072\'3f\u1089\'3f\u1087\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1103\'3f \u1074\'3f\u1089\'3f\u1077\'3f\u1093\'3f \u1087\'3f\u1077\'3f\u1088\'3f\u1089\'3f\u1086\'3f\u1085\'3f\u1072\'3f\u1078\'3f\u1077\'3f\u1081\'3f \u1074\'3f \u1086\'3f\u1075\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1077\'3f. \u1053\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1076\'3f\u1077\'3f\u1088\'3f\u1078\'3f\u1080\'3f\u1074\'3f\u1072\'3f\u1081\'3f\u1090\'3f\u1077\'3f\u1089\'3f\u1100\'3f \u1088\'3f\u1072\'3f\u1073\'3f\u1089\'3f\u1082\'3f\u1080\'3f \u1089\'3f\u1076\'3f\u1077\'3f\u1083\'3f\u1072\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1093\'3f \u1085\'3f\u1080\'3f\u1078\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1083\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1081\'3f.}
\par \pard\plain \s0\rtlch\af11\afs24\alang1037 \ltrch\lang1049\langfe2052\hich\af5\loch\qj\fi567\nowidctlpar\hyphpar0\rtlpar\f5\fs24\i0\b0\cf0\lang1049\kerning1\dbch\af8\langfe2052\ql\fi567\li0\lin0\ri0\rin0\sb0\sa0\ltrpar{\loch\lang1049\loch
\u1042\'3f \u1085\'3f\u1072\'3f\u1095\'3f\u1072\'3f\u1083\'3f\u1077\'3f \u1080\'3f\u1075\'3f\u1088\'3f\u1099\'3f \u1082\'3f\u1086\'3f\u1084\'3f\u1087\'3f\u1100\'3f\u1102\'3f\u1090\'3f\u1077\'3f\u1088\'3f \u1074\'3f\u1086\'3f\u1089\'3f\u1087\'3f\u1088\'3f\u1086\'3f\u1080\'3f\u1079\'3f\u1074\'3f\u1086\'3f\u1076\'3f\u1080\'3f\u1090\'3f \u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1079\'3f \u1086\'3f\u1075\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1072\'3f] \u1075\'3f\u1076\'3f\u1077\'3f \u1087\'3f\u1086\'3f\u1103\'3f\u1074\'3f\u1083\'3f\u1103\'3f\u1102\'3f\u1090\'3f\u1089\'3f\u1103\'3f: \u1075\'3f\u1080\'3f\u1073\'3f\u1080\'3f, \u1086\'3f\u1073\'3f\u1086\'3f\u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1077\'3f \u1073\'3f\u1091\'3f\u1082\'3f\u1074\'3f\u1072\'3f\u1084\'3f\u1080\'3f \u1043\'3f; \u1094\'3f\u1074\'3f\u1077\'3f\u1090\'3f\u1099\'3f \u1089\'3f \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1072\'3f\u1084\'3f\u1080\'3f, \u1086\'3f\u1073\'3f\u1086\'3f\u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1077\'3f \u1094\'3f\u1080\'3f\u1092\'3f\u1088\'3f\u1086\'3f\u1081\'3f, \u1087\'3f\u1086\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1102\'3f\u1097\'3f\u1080\'3f\u1081\'3f \u1095\'3f\u1080\'3f\u1089\'3f\u1083\'3f\u1086\'3f \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1074\'3f, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1084\'3f\u1086\'3f\u1078\'3f\u1085\'3f\u1086\'3f \u1089\'3f\u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1089\'3f \u1101\'3f\u1090\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1094\'3f\u1074\'3f\u1077\'3f\u1090\'3f\u1082\'3f\u1072\'3f (\u1077\'3f\u1089\'3f\u1090\'3f\u1100\'3f \u1094\'3f\u1074\'3f\u1077\'3f\u1090\'3f\u1082\'3f\u1080\'3f \u1089\'3f \u1086\'3f\u1076\'3f\u1085\'3f\u1080\'3f\u1084\'3f \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1084\'3f, \u1085\'3f\u1072\'3f\u1080\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1077\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1091\'3f\u1082\'3f\u1090\'3f\u1080\'3f\u1074\'3f\u1085\'3f\u1099\'3f\u1077\'3f, \u1080\'3f \u1094\'3f\u1074\'3f\u1077\'3f\u1090\'3f\u1082\'3f\u1080\'3f \u1089\'3f \u1076\'3f\u1077\'3f\u1074\'3f\u1103\'3f\u1090\'3f\u1100\'3f\u1102\'3f \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1072\'3f\u1084\'3f\u1080\'3f, \u1085\'3f\u1072\'3f\u1080\'3f\u1073\'3f\u1086\'3f\u1083\'3f\u1077\'3f\u1077\'3f \u1087\'3f\u1088\'3f\u1086\'3f\u1076\'3f\u1091\'3f\u1082\'3f\u1090\'3f\u1080\'3f\u1074\'3f\u1085\'3f\u1099\'3f\u1077\'3f); \u1096\'3f\u1072\'3f\u1076\'3f\u1086\'3f\u1082\'3f, \u1087\'3f\u1088\'3f\u1077\'3f\u1076\'3f\u1089\'3f\u1090\'3f\u1072\'3f\u1074\'3f\u1083\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1081\'3f \u1082\'3f\u1088\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1080\'3f\u1082\'3f\u1086\'3f\u1084\'3f (\u215\'d7); \u1087\'3f\u1091\'3f\u1089\'3f\u1090\'3f\u1099\'3f\u1077\'3f \u1084\'3f\u1077\'3f\u1089\'3f\u1090\'3f\u1072\'3f, \u1086\'3f\u1073\'3f\u1086\'3f\u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1077\'3f \u1090\'3f\u1086\'3f\u1095\'3f\u1082\'3f\u1086\'3f\u1081\'3f. \u1042\'3f\u1086\'3f\u1090\'3f \u1074\'3f\u1086\'3f\u1079\'3f\u1084\'3f\u1086\'3f\u1078\'3f\u1085\'3f\u1072\'3f\u1103\'3f \u1082\'3f\u1086\'3f\u1084\'3f\u1073\'3f\u1080\'3f\u1085\'3f\u1072\'3f\u1094\'3f\u1080\'3f\u1103\'3f. \u1042\'3f \u1085\'3f\u1077\'3f\u1081\'3f 12 \u1089\'3f\u1090\'3f\u1088\'3f\u1086\'3f\u1082\'3f \u1087\'3f\u1086\'3f 20 \u1087\'3f\u1086\'3f\u1083\'3f\u1077\'3f\u1081\'3f, \u1089\'3f 15 \u1075\'3f\u1080\'3f\u1073\'3f\u1080\'3f \u1080\'3f 20 \u1094\'3f\u1074\'3f\u1077\'3f\u1090\'3f\u1082\'3f\u1072\'3f\u1084\'3f\u1080\'3f. \u1042\'3f\u1089\'3f\u1077\'3f \u1080\'3f\u1093\'3f \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1103\'3f \u1091\'3f\u1082\'3f\u1072\'3f\u1079\'3f\u1072\'3f\u1085\'3f\u1099\'3f. \u1064\'3f\u1072\'3f\u1076\'3f\u1086\'3f\u1082\'3f \u1080\'3f\u1084\'3f\u1077\'3f\u1077\'3f\u1090\'3f \u1087\'3f\u1088\'3f\u1072\'3f\u1074\'3f\u1086\'3f \u1085\'3f\u1072\'3f 40 \u1093\'3f\u1086\'3f\u1076\'3f\u1086\'3f\u1074\'3f, \u1095\'3f\u1090\'3f\u1086\'3f\u1073\'3f\u1099\'3f \u1089\'3f\u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1090\'3f\u1100\'3f 100 \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1074\'3f. \u1050\'3f\u1086\'3f\u1084\'3f\u1087\'3f\u1100\'3f\u1102\'3f\u1090\'3f\u1077\'3f\u1088\'3f \u1087\'3f\u1086\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1103\'3f\u1085\'3f\u1085\'3f\u1086\'3f \u1089\'3f\u1086\'3f\u1086\'3f\u1073\'3f\u1097\'3f\u1072\'3f\u1077\'3f\u1090\'3f \u1095\'3f\u1080\'3f\u1089\'3f\u1083\'3f\u1086\'3f \u1086\'3f\u1089\'3f\u1090\'3f\u1072\'3f\u1074\'3f\u1096\'3f\u1080\'3f\u1093\'3f\u1089\'3f\u1103\'3f \u1093\'3f\u1086\'3f\u1076\'3f\u1086\'3f\u1074\'3f \u1080\'3f \u1095\'3f\u1080\'3f\u1089\'3f\u1083\'3f\u1086\'3f \u1091\'3f\u1078\'3f\u1077\'3f \u1089\'3f\u1086\'3f\u1073\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1085\'3f\u1099\'3f\u1093\'3f \u1090\'3f\u1088\'3f\u1072\'3f\u1085\'3f\u1079\'3f\u1080\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1086\'3f\u1074\'3f.}
