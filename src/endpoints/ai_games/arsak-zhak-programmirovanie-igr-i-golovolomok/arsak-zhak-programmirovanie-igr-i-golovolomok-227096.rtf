\'3f \u1090\'3f\u1072\'3f\u1082\'3f\u1078\'3f\u1077\'3f \u1080\'3f \u1083\'3f\u1102\'3f\u1073\'3f\u1086\'3f\u1081\'3f \u1076\'3f\u1088\'3f\u1091\'3f\u1075\'3f\u1086\'3f\u1081\'3f \u1087\'3f\u1086\'3f\u1089\'3f\u1083\'3f\u1077\'3f\u1076\'3f\u1091\'3f\u1102\'3f\u1097\'3f\u1080\'3f\u1081\'3f \u1076\'3f\u1077\'3f\u1085\'3f\u1100\'3f. \u1055\'3f\u1086\'3f\u1101\'3f\u1090\'3f\u1086\'3f\u1084\'3f\u1091\'3f \u1074\'3f\u1099\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1087\'3f\u1080\'3f\u1089\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1077\'3f\u1090\'3f\u1077\'3f \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f 1 \u1076\'3f\u1072\'3f\u1090\'3f\u1077\'3f 30 \u1076\'3f\u1077\'3f\u1082\'3f\u1072\'3f\u1073\'3f\u1088\'3f\u1103\'3f, \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f 2 \u1076\'3f\u1072\'3f\u1090\'3f\u1077\'3f 29 \u1076\'3f\u1077\'3f\u1082\'3f\u1072\'3f\u1073\'3f\u1088\'3f\u1103\'3f, \u1080\'3f \u1090\'3f, \u1076\'3f. \u1058\'3f\u1086\'3f \u1078\'3f\u1077\'3f \u1076\'3f\u1083\'3f\u1103\'3f \u1083\'3f\u1102\'3f\u1073\'3f\u1086\'3f\u1075\'3f\u1086\'3f 31 \u1095\'3f\u1080\'3f\u1089\'3f\u1083\'3f\u1072\'3f; \u1080\'3f\u1079\'3f \u1085\'3f\u1077\'3f\u1075\'3f\u1086\'3f \u1084\'3f\u1086\'3f\u1078\'3f\u1085\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1091\'3f\u1095\'3f\u1080\'3f\u1090\'3f\u1100\'3f 31 \u1095\'3f\u1080\'3f\u1089\'3f\u1083\'3f\u1086\'3f \u1074\'3f\u1089\'3f\u1077\'3f\u1093\'3f \u1087\'3f\u1086\'3f\u1089\'3f\u1083\'3f\u1077\'3f\u1076\'3f\u1091\'3f\u1102\'3f\u1097\'3f\u1080\'3f\u1093\'3f \u1084\'3f\u1077\'3f\u1089\'3f\u1103\'3f\u1094\'3f\u1077\'3f\u1074\'3f. \u1055\'3f\u1086\'3f\u1101\'3f\u1090\'3f\u1086\'3f\u1084\'3f\u1091\'3f 31 \u1086\'3f\u1082\'3f\u1090\'3f\u1103\'3f\u1073\'3f\u1088\'3f\u1103\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1091\'3f\u1095\'3f\u1072\'3f\u1077\'3f\u1090\'3f 1, 31 \u1072\'3f\u1074\'3f\u1075\'3f\u1091\'3f\u1089\'3f\u1090\'3f\u1072\'3f 2 \u1080\'3f \u1090\'3f. \u1076\'3f.}
\par \pard\plain \s0\rtlch\af11\afs24\alang1037 \ltrch\lang1049\langfe2052\hich\af5\loch\qj\fi567\nowidctlpar\hyphpar0\rtlpar\f5\fs24\i0\b0\cf0\lang1049\kerning1\dbch\af8\langfe2052\ql\fi567\li0\lin0\ri0\rin0\sb0\sa0\ltrpar{\loch\lang1049\loch
\u1055\'3f\u1086\'3f\u1089\'3f\u1083\'3f\u1077\'3f \u1101\'3f\u1090\'3f\u1086\'3f\u1075\'3f\u1086\'3f \u1074\'3f\u1099\'3f \u1084\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1090\'3f\u1077\'3f \u1079\'3f\u1072\'3f\u1082\'3f\u1086\'3f\u1085\'3f\u1095\'3f\u1080\'3f\u1090\'3f\u1100\'3f \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f \u1090\'3f\u1072\'3f\u1073\'3f\u1083\'3f\u1080\'3f\u1094\'3f\u1099\'3f \u1080\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1087\'3f\u1080\'3f\u1089\'3f\u1072\'3f\u1090\'3f\u1100\'3f \u1095\'3f\u1080\'3f\u1089\'3f\u1083\'3f\u1086\'3f \u1057\'3f\u1087\'3f\u1088\'3f\u1072\'3f\u1075\'3f\u1072\'3f\_\u1043\'3f\u1088\'3f\u1102\'3f\u1085\'3f\u1076\'3f\u1080\'3f \u1074\'3f\u1089\'3f\u1077\'3f\u1084\'3f \u1076\'3f\u1085\'3f\u1103\'3f\u1084\'3f \u1075\'3f\u1086\'3f\u1076\'3f\u1072\'3f. \u1042\'3f\u1099\'3f \u1091\'3f\u1074\'3f\u1080\'3f\u1076\'3f\u1080\'3f\u1090\'3f\u1077\'3f \u1090\'3f\u1072\'3f\u1082\'3f\u1078\'3f\u1077\'3f \u1087\'3f\u1086\'3f\u1103\'3f\u1074\'3f\u1083\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f \u1076\'3f\u1085\'3f\u1077\'3f\u1081\'3f \u1089\'3f\u1086\'3f \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f\u1084\'3f 0, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1103\'3f\u1074\'3f\u1083\'3f\u1103\'3f\u1102\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1074\'3f\u1099\'3f\u1080\'3f\u1075\'3f\u1088\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1102\'3f\u1097\'3f\u1080\'3f\u1084\'3f\u1080\'3f \u1076\'3f\u1085\'3f\u1103\'3f\u1084\'3f\u1080\'3f. \u1053\'3f\u1072\'3f\u1087\'3f\u1086\'3f\u1084\'3f\u1080\'3f\u1085\'3f\u1072\'3f\u1102\'3f \u1074\'3f\u1072\'3f\u1084\'3f \u1087\'3f\u1088\'3f\u1072\'3f\u1074\'3f\u1080\'3f\u1083\'3f\u1086\'3f: \u1082\'3f\u1072\'3f\u1078\'3f\u1076\'3f\u1086\'3f\u1084\'3f\u1091\'3f \u1080\'3f\u1075\'3f\u1088\'3f\u1086\'3f\u1074\'3f\u1086\'3f\u1084\'3f\u1091\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1102\'3f \u1087\'3f\u1088\'3f\u1080\'3f\u1087\'3f\u1080\'3f\u1089\'3f\u1099\'3f\u1074\'3f\u1072\'3f\u1077\'3f\u1090\'3f\u1089\'3f\u1103\'3f \u1085\'3f\u1072\'3f\u1080\'3f\u1084\'3f\u1077\'3f\u1085\'3f\u1100\'3f\u1096\'3f\u1077\'3f\u1077\'3f \u1085\'3f\u1077\'3f\u1086\'3f\u1090\'3f\u1088\'3f\u1080\'3f\u1094\'3f\u1072\'3f\u1090\'3f\u1077\'3f\u1083\'3f\u1100\'3f\u1085\'3f\u1086\'3f\u1077\'3f \u1094\'3f\u1077\'3f\u1083\'3f\u1086\'3f\u1077\'3f \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1077\'3f, \u1086\'3f\u1090\'3f\u1083\'3f\u1080\'3f\u1095\'3f\u1085\'3f\u1086\'3f\u1077\'3f \u1086\'3f\u1090\'3f \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1081\'3f \u1090\'3f\u1077\'3f\u1093\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1081\'3f, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1084\'3f\u1086\'3f\u1078\'3f\u1085\'3f\u1086\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1091\'3f\u1095\'3f\u1080\'3f\u1090\'3f\u1100\'3f, \u1080\'3f\u1089\'3f\u1093\'3f\u1086\'3f\u1076\'3f\u1103\'3f \u1080\'3f\u1079\'3f \u1076\'3f\u1072\'3f\u1085\'3f\u1085\'3f\u1086\'3f\u1075\'3f\u1086\'3f, \u1090\'3f. \u1077\'3f. \u1074\'3f \u1085\'3f\u1072\'3f\u1089\'3f\u1090\'3f\u1086\'3f\u1103\'3f\u1097\'3f\u1077\'3f\u1084\'3f \u1089\'3f\u1083\'3f\u1091\'3f\u1095\'3f\u1072\'3f\u1077\'3f \u8211\'96 \u1086\'3f\u1090\'3f \u1079\'3f\u1085\'3f\u1072\'3f\u1095\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1081\'3f \u1090\'3f\u1077\'3f\u1093\'3f \u1087\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1085\'3f\u1080\'3f\u1081\'3f, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1088\'3f\u1072\'3f\u1089\'3f\u1087\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1085\'3f\u1099\'3f \u1087\'3f\u1088\'3f\u1072\'3f\u1074\'3f\u1077\'3f\u1077\'3f, \u1080\'3f \u1090\'3f\u1077\'3f\u1093\'3f, \u1082\'3f\u1086\'3f\u1090\'3f\u1086\'3f\u1088\'3f\u1099\'3f\u1077\'3f \u1088\'3f\u1072\'3f\u1089\'3f\u1087\'3f\u1086\'3f\u1083\'3f\u1086\'3f\u1078\'3f\u1077\'3f\u1085\'3f\u1099\'3f \u1085\'3f\u1080\'3f\u1078\'3f\u1077\'3f.}
