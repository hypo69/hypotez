{
  "product_links": {
    "attribute": "href",

    "by": "XPATH",
    "strategy_for_multiple_selectors": "find_first_match","selector": "//h2[contains(@class, 'prod-thumb-title')]//a",

    "if_list": "first",

    "mandatory": true,
    "timeout": 0,
    "timeout_for_event": "presence_of_element_located",
    "event": false,
    "locator_description": "Список ссылок на товары со страницы категории"
  },
  "show_more": {
    "attribute": false,
    "by": "XPATH",
    "strategy_for_multiple_selectors": "find_first_match","selector": "//div[@class='show-more']",
    "timeout": 0,
    "timeout_for_event": "presence_of_element_located",
    "event": "click()",
    "mandatory": false,
    "locator_description": "Следует проверять наличие элемента. Пока элемент прицутствует - нажимать его. Когда пропал - пора собирать ссылки на товары"
  }
}